---
layout: default
---
<div class="post home-page">
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">Robotics &middot; Learning</p>
      <header class="post-header">
        <h1 class="post-title" id="intro-title">
          {{ site.first_name }}
          <span>{{ site.last_name }}</span>
        </h1>
        <p class="intro-role">Ph.D. student at KTH Royal Institute of Technology</p>
      </header>
      <div class="intro-bio">{{ content }}</div>
      <div class="intro-links">
        <a class="research-link" href="{{ '/publications/' | relative_url }}">Explore my research <span aria-hidden="true">↗</span></a>
        <a href="mailto:{{ site.email }}">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {% if page.profile %}
      <aside class="intro-portrait">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% include figure.liquid loading="eager" path=profile_image_path class="portrait-image" sizes="(min-width: 768px) 280px, 200px" alt="Yufei Duan" cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.subtitle %}
          {% assign quote_parts = page.subtitle | split: '--' %}
          <blockquote class="portrait-quote">
            <p>&ldquo;{{ quote_parts.first | strip }}&rdquo;</p>
            {% if quote_parts.size > 1 -%}
              <cite>{{ quote_parts.last | strip }}</cite>
            {%- endif %}
          </blockquote>
        {% endif %}
      </aside>
    {% endif %}
  </section>

  {% if page.news and site.announcements.enabled %}
    <section class="home-section home-news" aria-labelledby="news-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">From the lab &amp; beyond</p>
          <h2 id="news-heading">News</h2>
        </div>
        <a class="section-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if site.latest_posts.enabled %}
    <section class="home-section home-writing" aria-labelledby="writing-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Ideas &amp; reflections</p>
          <h2 id="writing-heading">Blogs</h2>
        </div>
        <a class="section-link" href="{{ '/blog/' | relative_url }}">Visit the blog <span aria-hidden="true">↗</span></a>
      </div>
      {% assign personal_posts = site.posts | where: 'personal_blog', true %}
      {% for post in personal_posts limit: 3 %}
        <article class="writing-entry">
          <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%B %d, %Y' }}</time>
          <div>
            <h3>
              <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
            </h3>
            <p>{{ post.description }}</p>
            <a class="text-link" href="{{ post.url | relative_url }}">Read the essay <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% endfor %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section home-research" aria-labelledby="research-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research</p>
          <h2 id="research-heading">Selected publications</h2>
        </div>
        <a class="section-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.social %}
    <section class="home-contact social" aria-labelledby="contact-heading">
      <div>
        <h2 id="contact-heading">Let&rsquo;s connect.</h2>
        <p>For research conversations and collaborations.</p>
      </div>
      <div class="contact-icons">{% include social.liquid %}</div>
    </section>
  {% endif %}
</div>
